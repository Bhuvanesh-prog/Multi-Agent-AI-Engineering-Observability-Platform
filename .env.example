# Copy to .env (git-ignored) and replace every placeholder. Never commit real values.

# Host port for Orbit Postgres (5433 avoids clashing with a locally installed Postgres)
ORBIT_PG_PORT=5433

# Postgres superuser (local only) and Orbit roles created by db/init/01-orbit.sh
POSTGRES_PASSWORD=change-me
ORBIT_OWNER_PASSWORD=change-me
ORBIT_APP_PASSWORD=change-me

# Service Bus emulator's SQL Server (needs 8+ chars with upper, lower, digit and symbol)
SB_SQL_PASSWORD=change-me
# Setting Y accepts the SQL Server and Service Bus emulator license terms
ACCEPT_EULA=N

# Connection settings consumed by the services (placeholders; real values come from .env / Key Vault)
ConnectionStrings__Orbit=Host=127.0.0.1;Port=5433;Database=orbit;Username=orbit_app;Password=change-me
ConnectionStrings__ServiceBus=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
# URL form: percent-encode the password (e.g. # -> %23, % -> %25, + -> %2B)
ORBIT_DATABASE_URL=postgresql://orbit_app:change-me@127.0.0.1:5433/orbit
ORBIT_SERVICEBUS_CONNECTION=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
